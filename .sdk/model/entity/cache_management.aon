# Entity: cache_management

main: kit: entity: cache_management: {

  alias: field: {}

  name: "cache_management"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "domain"
                orig: "domain"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/management/cache/domain-age/check/{domain}"
          segments: [
            {
              lit: "management"
            }
            {
              lit: "cache"
            }
            {
              lit: "domain-age"
            }
            {
              lit: "check"
            }
            {
              var: "domain"
            }
          ]
          select: {
            exist: [
              "domain"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/management/cache/domain-age/stats"
          segments: [
            {
              lit: "management"
            }
            {
              lit: "cache"
            }
            {
              lit: "domain-age"
            }
            {
              lit: "stats"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          method: "DELETE"
          orig: "/management/cache/domain-age"
          segments: [
            {
              lit: "management"
            }
            {
              lit: "cache"
            }
            {
              lit: "domain-age"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "DELETE"
          orig: "/management/cache/domain-age/all"
          segments: [
            {
              lit: "management"
            }
            {
              lit: "cache"
            }
            {
              lit: "domain-age"
            }
            {
              lit: "all"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }

  relations: {
    ancestors: [
      [
        "check"
      ]
    ]
  }



}
