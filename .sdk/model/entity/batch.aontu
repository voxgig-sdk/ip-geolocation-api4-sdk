# Entity: batch

main: kit: entity: batch: {

  alias: field: {}

  fields: [
    {
      name: "emails"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "ips"
      req: true
      type: "`$ARRAY`"
    }
  ]

  name: "batch"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/v1/email/advanced/batch"
          parts: [
            "api"
            "v1"
            "email"
            "advanced"
            "batch"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
        {
          method: "POST"
          orig: "/api/v1/ip/batch"
          parts: [
            "api"
            "v1"
            "ip"
            "batch"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
