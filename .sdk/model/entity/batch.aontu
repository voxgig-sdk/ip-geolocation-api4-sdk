# Entity: batch

main: kit: entity: batch: {

  alias: field: {}

  fields: {
    emails: {
      h: "Emails"
      n: "emails"
      r: true
      sh: "List of email addresses to validate."
      t: "`$ARRAY`"
    }
    ips: {
      h: "Ips"
      n: "ips"
      r: true
      sh: "List of IP addresses to look up."
      t: "`$ARRAY`"
    }
  }

  name: "batch"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /api/v1/email/advanced/batch"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/email/advanced/batch"
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "email"
            }
            {
              lit: "advanced"
            }
            {
              lit: "batch"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
        {
          co: {
            id: "POST /api/v1/ip/batch"
            source: "openapi3"
            version: 2
          }
          m: "POST"
          o: "/api/v1/ip/batch"
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "ip"
            }
            {
              lit: "batch"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
