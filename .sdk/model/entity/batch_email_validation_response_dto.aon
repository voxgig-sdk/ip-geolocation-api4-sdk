# Entity: batch_email_validation_response_dto

main: kit: entity: batch_email_validation_response_dto: {

  alias: field: {}

  fields: [
    {
      name: "failed_validations"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "results"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "successful_validations"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "total_processed"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "batch_email_validation_response_dto"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/v1/email/advanced/batch/csv"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "email"
            }
            {
              lit: "advanced"
            }
            {
              lit: "batch"
            }
            {
              lit: "csv"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
