er @)\",\"example\":\"yandex.ru\",\"type\":\"string\"},\"username\":{\"description\":\"The username/local part of the email address (before @)\",\"example\":\"test\",\"type\":\"string\"},\"valid\":{\"description\":\"Whether the email syntax is valid according to RFC standards\",\"example\":true,\"type\":\"boolean\"}},\"required\":[\"domain\",\"username\",\"valid\"],\"type\":\"object\"}},\"required\":[\"disposable\",\"email\",\"free\",\"has_mx_records\",\"reachable\",\"role_account\",\"suggestion\",\"syntax\"],\"type\":\"object\"},\"description\":\"Map of email addresses to their validation results. The key is the original email address, \\nand the value is the complete validation result.\",\"type\":\"object\"},\"successfulValidations\":{\"description\":\"Number of emails that were successfully validated.\",\"example\":2,\"format\":\"int32\",\"type\":\"integer\"},\"totalProcessed\":{\"description\":\"Total number of emails processed in this batch.\",\"example\":2,\"format\":\"int32\",\"type\":\"integer\"}},\"required\":[\"failedValidations\",\"results\",\"successfulValidations\",\"totalProcessed\"],\"type\":\"object\"}}},\"description\":\"Bad Request - Invalid CSV format, empty file, no emails found, or exceeds maximum batch size\"},\"429\":{\"content\":{\"*/*\":{\"schema\":{\"description\":\"Response object containing validation results for all processed emails in a batch request.\",\"example\":{\"failed_validations\":0,\"results\":{\"user1@example.com\":{\"disposable\":false,\"email\":\"user1@example.com\",\"free\":false,\"gravatar\":{\"gravatar_url\":\"\",\"has_gravatar\":false},\"has_mx_records\":true,\"reachable\":\"yes\",\"role_account\":false,\"smtp\":{\"catch_all\":false,\"deliverable\":true,\"disabled\":false,\"full_inbox\":false,\"host_exists\":true},\"suggestion\":\"\",\"syntax\":{\"domain\":\"example.com\",\"username\":\"user1\",\"valid\":true}},\"user2@gmail.com\":{\"disposable\":false,\"email\":\"user2@gmail.com\",\"free\":true,\"gravatar\":null,\"has_m