# Entity: batch_email_validation_response_dto

main: kit: entity: batch_email_validation_response_dto: {

  alias: field: {}

  fields: [
    {
      name: "failed_validations"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "results"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "successful_validations"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "total_processed"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "batch_email_validation_response_dto"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/v1/email/advanced/batch/csv"
          parts: [
            "api"
            "v1"
            "email"
            "advanced"
            "batch"
            "csv"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
