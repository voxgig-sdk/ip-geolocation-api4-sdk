# Entity: batch

main: kit: entity: batch: {

  alias: field: {}

  fields: [
    {
      name: "emails"
      req: true
      short: "List of email addresses to validate."
      type: "`$ARRAY`"
    }
    {
      name: "ips"
      req: true
      short: "List of IP addresses to look up."
      type: "`$ARRAY`"
    }
  ]

  name: "batch"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/api/v1/email/advanced/batch"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "email"
            }
            {
              lit: "advanced"
            }
            {
              lit: "batch"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
        {
          method: "POST"
          orig: "/api/v1/ip/batch"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "ip"
            }
            {
              lit: "batch"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
  }



}
