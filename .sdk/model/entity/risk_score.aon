# Entity: risk_score

main: kit: entity: risk_score: {

  alias: field: {}

  fields: [
    {
      name: "email_factors"
      req: true
      short: "Email-specific risk factors and validation results."
      type: "`$NULL`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
    {
      name: "ip_factors"
      req: true
      short: "IP-specific risk factors and analysis results."
      type: "`$NULL`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "risk_score"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "203.0.113.195"
                kind: "param"
                name: "id"
                orig: "ip"
                reqd: true
                type: "`$STRING`"
              }
            ]
            query: [
              {
                example: "suspicious.user@tempmail.com"
                kind: "query"
                name: "email"
                orig: "email"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/v1/risk-score/{ip}"
          rename: {
            param: {
              ip: "id"
            }
          }
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "risk-score"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "email"
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.factors`"
          }
        }
        {
          method: "GET"
          orig: "/api/v1/risk-score"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "risk-score"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body.factors`"
          }
        }
      ]
    }
  }



}
