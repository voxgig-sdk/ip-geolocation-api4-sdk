# Entity: forward

main: kit: entity: forward: {

  alias: field: {}

  fields: [
    {
      name: "addresses"
      req: true
      type: "`$ARRAY`"
    }
    {
      name: "hostname"
      req: true
      type: "`$STRING`"
    }
    {
      name: "id"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "forward"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                example: "dns.google"
                kind: "param"
                name: "id"
                orig: "hostname"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/api/v1/dns/forward/{hostname}"
          rename: {
            param: {
              hostname: "id"
            }
          }
          segments: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "dns"
            }
            {
              lit: "forward"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
