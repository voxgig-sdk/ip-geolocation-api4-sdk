                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/v1/ip-reputation/{ip}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              ip: "id"
            }
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "v1"
            }
            {
              lit: "ip-reputation"
            }
            {
              var: "id"
            }
          ]
          t: {
