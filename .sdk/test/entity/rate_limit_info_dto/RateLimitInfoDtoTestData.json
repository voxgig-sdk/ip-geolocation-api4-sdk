                      "description": "Email validation API rate limit information",
                      "properties": {
                        "limit": {
                          "description": "Maximum number of requests allowed in the rate limit interval",
                          "example": 100000,
                          "format": "int64",
                          "type": "integer"
                        },
                        "remaining": {
                          "description": "Remaining requests available in the current interval",
                          "example": 87532,
                          "format": "int64",
                          "type": "integer"
                        },
                        "usage_percent": {
                          "description": "Percentage of quota utilized (0-100)",
                          "example": 12.47,
                          "format": "double",
                          "type": "number"
                        },
                        "used": {
                          "description": "Number of requests consumed in the current interval",
                          "example": 12468,
                          "format": "int64",
                          "type": "integer"
                        }
                      },
                      "required": [
                        "limit",
                        "remaining",
                        "usage_percent",
                        "used"
                      ],
                      "type": "object"
                    },
                    "interval_seconds": {
                      "description": "Rate limit interval in seconds (time period for quota renewal)",
                      "example": 2678400,
                      "format": "int64",
                      "type": "integer"
